{
  "name": "LOG791",
  "dockerComposeFile": "compose.yml",
  "service": "dev",
  "runServices": ["dev", "postgres", "ldap", "ldap-seed"],
  "workspaceFolder": "/workspaces/LOG791",
  "features": {
    // A dockerd inside the container, where runsc can be registered (see Dockerfile).
    // Docker CE rather than Moby, which is not packaged for Debian trixie.
    "ghcr.io/devcontainers/features/docker-in-docker:4": { "moby": false },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    // Same version as rust-toolchain.toml, which rustup reads; otherwise a second toolchain is installed.
    "ghcr.io/devcontainers/features/rust:1": { "version": "1.99.1" }
  },
  "forwardPorts": [8000, 8001, "ldap:17170"],
  "portsAttributes": {
    "8000": { "label": "API" },
    "8001": { "label": "Admin" },
    "ldap:17170": { "label": "lldap (admin / pals-admin)" }
  },
  // Dependencies are fetched once per build; builds go to CARGO_TARGET_DIR, outside the bind mount.
  // The commit-msg hook is enabled in .git/config, shared with the host.
  "postCreateCommand": "cargo fetch --locked && git config core.hooksPath .githooks",
  "postStartCommand": "bash .devcontainer/check.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "fill-labs.dependi",
        "ms-azuretools.vscode-containers",
        "myriad-dreamin.tinymist",
        "redhat.ansible",
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml"
      ]
    }
  }
}

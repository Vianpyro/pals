# {{ ansible_managed }}
# The same routes as .devcontainer/nginx.conf, over HTTPS only.

server {
    listen 80;
    listen [::]:80;
    server_name {{ nginx_server_name }};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name {{ nginx_server_name }};
    ssl_certificate /etc/nginx/tls/log791.crt;
    ssl_certificate_key /etc/nginx/tls/log791.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    root {{ log791_web_dir }};

    include snippets/web.conf;

    location /api/ {
        # The trailing slash strips /api: the API keeps its own routes
        proxy_pass http://127.0.0.1:8080/;
        # The event stream stays open; the API sends X-Accel-Buffering: no and a keep-alive every 15 s
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        # The API accepts 1 MiB of source; its JSON escaping can double that
        client_max_body_size 2m;
        include snippets/security-headers.conf;
    }
}

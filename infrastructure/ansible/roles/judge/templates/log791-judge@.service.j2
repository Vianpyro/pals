# {{ ansible_managed }}
# One instance per judge: log791-judge@1, @2... (ADR-0021)
[Unit]
Description=LOG791 judge %i: runs submissions in gVisor
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
User=log791-judge
Group=log791-judge
EnvironmentFile={{ log791_config }}/judge.env
# Submissions go here and are mounted into their sandbox: a path dockerd sees, so no PrivateTmp,
# and one directory per instance. Open to read: the sandbox runs as nobody.
RuntimeDirectory=log791-judge-%i
RuntimeDirectoryMode=0755
Environment=TMPDIR=/run/log791-judge-%i
ExecStart={{ log791_bin }}/judge
# Only on failure: a judge stopped on purpose stays stopped (ADR-0021)
Restart=on-failure
RestartSec=5

# It reads content and talks to PostgreSQL and dockerd: nothing else
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target

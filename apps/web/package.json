{
  "name": "@log791/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:demo": "vite build --config vite.demo.config.js",
    "check": "svelte-check --fail-on-warnings",
    "test": "node --test \"scripts/*.test.js\" \"locales/*.test.js\" \"src/lib/*.test.ts\" \"demo/*.test.ts\"",
    "budget": "node scripts/size-budget.js dist index.html=50"
  },
  "dependencies": {
    "@log791/ui": "*",
    "svelte": "5.57.3"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "26.6.6",
    "svelte-check": "4.7.7",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
